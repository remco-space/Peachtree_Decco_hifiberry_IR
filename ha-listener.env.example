# Copy to /etc/decco/ha-listener.env on the decco Pi (chmod 600, root-owned).
# Referenced by decco-pi-led-hifiberry.service via EnvironmentFile=.
# Do NOT commit the real file — it holds a long-lived HA access token.

# Home Assistant WebSocket endpoint. Use a hostname that matches the certificate
# HA presents, so TLS verification can stay on. If HA is HTTPS-only on the LAN
# with a public cert, add a hosts entry on the Pi pointing that name at the LAN
# address:
#   <lan-ip>  <your-ha-hostname>
HA_WS_URL=wss://your-ha-hostname:8123/api/websocket

# Create under HA profile -> Security -> Long-lived access tokens.
HA_TOKEN=replace-with-long-lived-token

# The event entity whose firing toggles the amplifier.
EVENT_ENTITY=event.your_toggle_entity
